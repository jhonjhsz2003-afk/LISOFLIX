{
  "name": "lisoflix",
  "version": "1.6.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute lisoflix-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute lisoflix-db --remote --file=./schema.sql",
    "check": "node --check src/worker.js && node --check public/app.js && node --check public/demo.js",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
